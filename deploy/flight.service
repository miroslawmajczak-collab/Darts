[Unit]
Description=FLIGHT offline darts application
After=local-fs.target

[Service]
Type=exec
User=flight
WorkingDirectory=/opt/flight
ExecStart=/usr/bin/node /opt/flight/server.mjs
Environment=FLIGHT_PORT=17840
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/flight/config
UMask=0077

[Install]
WantedBy=multi-user.target
